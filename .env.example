# Server-side API key for the serverless function
# This key is NEVER exposed to the browser — it's only used by /api/generate.ts
# Get your API key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_api_key_here

# For local development without Vercel CLI, you can also set this
# (the vite proxy will use it, but in production only DASHSCOPE_API_KEY matters)
VITE_DASHSCOPE_API_KEY=your_api_key_here
